# Backend Environment Configuration
# Copy this file to .env and update values as needed

# OPTION 1: Local Development (default)
# No special configuration needed - Flask runs on localhost:5000

# OPTION 2: ngrok Tunnel
# Set when using ngrok to allow Socket.IO connections
NGROK_URL=https://your-ngrok-url.ngrok-free.dev

# OPTION 3: Deployed Production
# Frontend URL for CORS configuration
FRONTEND_URL=https://your-production-domain.com

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False

# Optional: Port configuration (default 5000)
# FLASK_PORT=5000

# Optional: Enable detailed logging for debugging
# FLASK_DEBUG=True

# Optional: AI/Voice features
# Disabled by default if dependencies not installed
# ENABLE_GPU=True
# ENABLE_VOICE=True

# Docker / container overrides
# FRONTEND_URL=http://localhost:3000
# BACKEND_PUBLIC_URL=http://localhost:5000
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# POPPLER_PATH=/usr/bin
# TESSERACT_CMD=/usr/bin/tesseract
# USE_HTTPS=0

# ---- Vercel (cloud) deployment ----
# Set these in the Vercel project (see frontend/DEPLOY_VERCEL.md). Local runs do not need them.
# DATABASE_URL=postgres://...        # Neon, added by the Vercel integration
# GEMINI_API_KEY=your-gemini-api-key # OCR through Gemini
# OCR_MODEL=gemini-3.5-flash-lite
# SECRET_KEY=a-long-random-string
# PC_CLOUD=1                         # run the cloud code path on your own machine (uses DATABASE_URL)
