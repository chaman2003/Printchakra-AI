# Frontend Environment Configuration
# Copy this file to .env.local and update values as needed

# OPTION 1: Local Development (default)
# When running on localhost, the app automatically detects local backend
# No configuration needed - just leave this commented
# REACT_APP_API_URL=http://localhost:5000

# OPTION 2: ngrok/Tunnel Development
# REACT_APP_API_URL=https://your-ngrok-url.ngrok-free.dev

# OPTION 3: Vercel (set these in the Vercel project, not in a file)
# REACT_APP_API_URL=https://printchakra-api.vercel.app
# REACT_APP_REALTIME=poll        # HTTP polling instead of Socket.IO (Vercel has no websockets)

# Debug logging (optional)
REACT_APP_DEBUG=false

# ---- Server-side settings for the voice token function (frontend/api/gemini-token.js) ----
# Do NOT prefix these with REACT_APP_. They stay on the server.
GEMINI_API_KEY=your-gemini-api-key
MODEL=gemini-3.8-live
VOICE=Kore
LANGUAGE=en-IN
